# Netlify · cabeceras.
#
# EL NOMBRE IMPORTA: el archivo tiene que llamarse exactamente "_headers",
# sin punto ni extensión, y estar junto al index.html. Antes se llamaba
# "_headers.txt" y por eso Netlify lo ignoraba por completo: el sitio se
# publicaba sin ninguna de estas reglas.

# Imágenes y fuentes: caché de 1 año (mejora Core Web Vitals en visitas repetidas).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# El HTML no se cachea, para que los cambios se vean al instante.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
